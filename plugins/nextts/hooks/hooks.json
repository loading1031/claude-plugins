{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/check_next_conventions.py\"",
            "timeout": 10,
            "statusMessage": "Next.js 컨벤션 검사 중"
          }
        ]
      }
    ]
  }
}
